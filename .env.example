# YDNT - Required Environment Variables
# Copy this file to .env and fill in real values.
# .env is in .gitignore and will NEVER be committed.

# Gemini API Key from AI Studio (required: video sample in the coverage check,
# and the fallback backend when no Google Cloud credentials are available)
GEMINI_API_KEY=

# YouTube Data API v3 Key (required for real API calls)
YOUTUBE_API_KEY=

# Google Cloud Project ID (optional, for deployment)
# GOOGLE_CLOUD_PROJECT=

